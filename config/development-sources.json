{
  "$comment": "DEVELOPMENT ONLY. This file is read by src/dev-ingestor/ and by nothing in src/core/. Deleting the ingestor makes this file inert. Classifications come from docs/DEVELOPMENT-ASSET-SOURCES.md; do not raise automationAllowed without re-reading the terms of the source.",
  "version": 1,
  "updatedAt": "2026-08-19",

  "policy": {
    "neverBypass": [
      "authentication", "paywalls", "DRM", "CAPTCHAs", "anti-bot systems",
      "access controls", "download restrictions", "rate limits"
    ],
    "neverExecuteDownloadedCode": true,
    "requireLicenseBeforeDownload": true,
    "blockedClassifications": ["LICENSE UNKNOWN", "AUTOMATION NOT AVAILABLE"],
    "allowedLicenses": [
      "CC0-1.0", "PDM-1.0", "CC-BY-4.0", "CC-BY-3.0", "CC-BY-SA-4.0",
      "MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "Unlicense",
      "Pixabay-Content-License"
    ],
    "defaultUserAgent": "SunPlugin/0.1 (development asset ingestor; local editing toolkit)"
  },

  "sources": [
    {
      "id": "openverse",
      "name": "Openverse",
      "url": "https://openverse.org",
      "apiBase": "https://api.openverse.org/v1",
      "domains": ["https://api.openverse.org"],
      "categories": ["sfx", "music", "ambience", "image", "background", "overlay"],
      "accessMethod": "api",
      "adapter": "OpenverseAdapter",
      "automationAllowed": true,
      "classification": ["FREE", "PUBLIC DOMAIN", "OPEN LICENSE", "API AVAILABLE", "AUTOMATION POSSIBLE"],
      "license": "per-asset",
      "licenseFilter": ["cc0", "pdm", "by"],
      "attributionRequired": "per-asset",
      "registrationRequired": false,
      "commercialUse": "per-asset",
      "redistribution": "per-asset",
      "rateLimit": { "requestsPerMinute": 20, "concurrent": 2 },
      "enabled": true,
      "notes": "Aggregates 800M+ CC works. Primary discovery surface. License is machine-readable per result; the adapter hard-filters to the licenseFilter list."
    },
    {
      "id": "internet-archive",
      "name": "Internet Archive",
      "url": "https://archive.org",
      "apiBase": "https://archive.org",
      "domains": ["https://archive.org"],
      "categories": ["overlay", "film-burn", "film-grain", "video", "ambience", "music", "background"],
      "accessMethod": "public-endpoint",
      "adapter": "InternetArchiveAdapter",
      "automationAllowed": true,
      "classification": ["FREE", "PUBLIC DOMAIN", "API AVAILABLE", "AUTOMATION POSSIBLE"],
      "license": "per-item",
      "licenseFilter": ["publicdomain", "cc0", "by"],
      "attributionRequired": false,
      "registrationRequired": false,
      "commercialUse": "per-item",
      "redistribution": "per-item",
      "rateLimit": { "requestsPerMinute": 12, "concurrent": 1 },
      "enabled": true,
      "notes": "Best source of genuine public-domain film for burns, grain and leaks. Many items carry no rights metadata at all - the adapter refuses those rather than assuming public domain."
    },
    {
      "id": "wikimedia-commons",
      "name": "Wikimedia Commons",
      "url": "https://commons.wikimedia.org",
      "apiBase": "https://commons.wikimedia.org/w/api.php",
      "domains": ["https://commons.wikimedia.org", "https://upload.wikimedia.org"],
      "categories": ["image", "background", "video", "sfx"],
      "accessMethod": "api",
      "adapter": "WikimediaAdapter",
      "automationAllowed": true,
      "classification": ["FREE", "PUBLIC DOMAIN", "OPEN LICENSE", "API AVAILABLE", "AUTOMATION POSSIBLE"],
      "license": "per-file",
      "licenseFilter": ["cc0", "pdm", "public domain", "cc-by"],
      "attributionRequired": "per-file",
      "registrationRequired": false,
      "commercialUse": true,
      "redistribution": true,
      "rateLimit": { "requestsPerMinute": 30, "concurrent": 2 },
      "requiresUserAgent": true,
      "enabled": true,
      "notes": "The Wikimedia user-agent policy is mandatory: requests must identify the app and a contact. The adapter refuses to run without one."
    },
    {
      "id": "github",
      "name": "GitHub (open-license repositories)",
      "url": "https://github.com",
      "apiBase": "https://api.github.com",
      "domains": ["https://api.github.com", "https://raw.githubusercontent.com", "https://codeload.github.com"],
      "categories": ["lut", "sfx", "overlay", "preset", "template"],
      "accessMethod": "api",
      "adapter": "GitHubAdapter",
      "automationAllowed": true,
      "classification": ["FREE", "OPEN LICENSE", "API AVAILABLE", "AUTOMATION POSSIBLE"],
      "license": "per-repository",
      "licenseFilter": ["cc0-1.0", "mit", "apache-2.0", "bsd-2-clause", "bsd-3-clause", "unlicense", "cc-by-4.0"],
      "attributionRequired": "per-license",
      "registrationRequired": false,
      "commercialUse": "per-license",
      "redistribution": "per-license",
      "rateLimit": { "requestsPerMinute": 30, "concurrent": 2 },
      "auth": { "type": "token", "optional": true, "envVar": "GITHUB_TOKEN", "note": "Raises the rate limit from 60/h to 5000/h. Read-only public scope is sufficient." },
      "enabled": true,
      "notes": "Repositories reported as NOASSERTION by the license endpoint are treated as LICENSE UNKNOWN and refused."
    },
    {
      "id": "freesound",
      "name": "Freesound",
      "url": "https://freesound.org",
      "apiBase": "https://freesound.org/apiv2",
      "domains": ["https://freesound.org"],
      "categories": ["sfx", "whoosh", "impact", "riser", "ambience", "ui"],
      "accessMethod": "api",
      "adapter": "FreesoundAdapter",
      "automationAllowed": true,
      "classification": ["FREE", "PUBLIC DOMAIN", "OPEN LICENSE", "API AVAILABLE", "AUTOMATION POSSIBLE (user-auth)"],
      "license": "per-sound",
      "licenseFilter": ["Creative Commons 0"],
      "attributionRequired": "per-sound",
      "registrationRequired": true,
      "commercialUse": "per-sound",
      "redistribution": false,
      "rateLimit": { "requestsPerMinute": 30, "concurrent": 2 },
      "auth": {
        "type": "oauth2",
        "optional": false,
        "envVar": "FREESOUND_TOKEN",
        "note": "Search and metadata work with an API token. Downloading ORIGINAL files requires the user's own OAuth2 grant - this is the user authenticating themselves, not a bypass. Without it the adapter is preview-only and links out."
      },
      "enabled": false,
      "enabledReason": "Disabled until the user supplies their own Freesound credentials.",
      "notes": "Deepest CC0 SFX catalogue in existence. Worth connecting."
    },
    {
      "id": "pixabay",
      "name": "Pixabay",
      "url": "https://pixabay.com",
      "apiBase": "https://pixabay.com/api",
      "domains": ["https://pixabay.com", "https://cdn.pixabay.com"],
      "categories": ["video", "overlay", "background", "image", "music", "sfx"],
      "accessMethod": "api",
      "adapter": "PixabayAdapter",
      "automationAllowed": true,
      "classification": ["FREE", "API AVAILABLE", "AUTOMATION POSSIBLE (throttled)"],
      "license": "Pixabay-Content-License",
      "attributionRequired": false,
      "registrationRequired": true,
      "commercialUse": true,
      "redistribution": false,
      "rateLimit": { "requestsPerMinute": 60, "concurrent": 1, "cacheHours": 24 },
      "limits": { "maxPerCategoryPerSession": 50 },
      "auth": { "type": "apikey", "optional": false, "envVar": "PIXABAY_API_KEY" },
      "enabled": false,
      "enabledReason": "Disabled until the user supplies their own Pixabay API key.",
      "notes": "Terms state the API is for real human requests and prohibit systematic mass download. The adapter enforces the per-session cap, the 24h response cache, and refuses to hotlink. Redistribution of the asset as-is is prohibited: development-local use only, never ship."
    },
    {
      "id": "synthetic",
      "name": "Procedural Generator (local)",
      "url": null,
      "domains": [],
      "categories": ["lut", "sfx", "overlay", "background", "guide", "caption", "mogrt", "preset", "transition"],
      "accessMethod": "generator",
      "adapter": "SyntheticAdapter",
      "automationAllowed": true,
      "classification": ["FREE", "PUBLIC DOMAIN", "AUTOMATION POSSIBLE"],
      "license": "CC0-1.0",
      "attributionRequired": false,
      "registrationRequired": false,
      "commercialUse": true,
      "redistribution": true,
      "enabled": true,
      "notes": "Primary volume source and the only one that needs no network. LUTs, WAV SFX, PNG overlays/guides and SRT/VTT captions are REAL, usable files. MOGRT and prfpset output is explicitly a structural FIXTURE and is flagged syntheticFixture:true."
    },
    {
      "id": "direct-url",
      "name": "Direct URL (user-supplied)",
      "url": null,
      "domains": [],
      "categories": ["*"],
      "accessMethod": "direct",
      "adapter": "DirectUrlAdapter",
      "automationAllowed": true,
      "classification": ["LICENSE UNKNOWN"],
      "license": "user-declared",
      "attributionRequired": "unknown",
      "registrationRequired": false,
      "enabled": true,
      "requiresUserConfirmation": true,
      "notes": "Fetches a URL the user explicitly pasted. The user asserts they have the right to it; the adapter records that assertion on the asset. Refuses non-https, refuses cross-host redirects, and applies the same validation and quarantine rules as every other path."
    },
    {
      "id": "manual",
      "name": "Manual sources (link-out only)",
      "url": null,
      "domains": [],
      "categories": ["mogrt", "template", "transition", "preset", "caption", "video"],
      "accessMethod": "manual",
      "adapter": "ManualSourceAdapter",
      "automationAllowed": false,
      "classification": ["FREE", "MANUAL DOWNLOAD", "AUTOMATION NOT AVAILABLE"],
      "license": "per-site",
      "enabled": true,
      "notes": "OPEN SOURCE PAGE -> user downloads -> IMPORT. No automated fetching, ever.",
      "sites": [
        { "name": "Mixkit", "url": "https://mixkit.co/free-premiere-pro-templates/", "categories": ["mogrt", "transition", "title", "sfx", "music"], "license": "Mixkit License", "why": "Proprietary free license, silent on automation, so treated as prohibited. ~442 free Premiere templates." },
        { "name": "Motion Array (free tier)", "url": "https://motionarray.com/browse/free/", "categories": ["mogrt", "transition", "preset"], "license": "Motion Array Free", "why": "Account required; free-tier terms are per user." },
        { "name": "Pexels", "url": "https://www.pexels.com/videos/", "categories": ["video", "overlay", "background"], "license": "Pexels License", "why": "Terms EXPLICITLY prohibit bulk and systematic copying and scraping." },
        { "name": "Enchanted Media", "url": "https://www.enchanted.media/free-premiere-pro-motion-graphics-templates/", "categories": ["mogrt", "lower-thirds"], "license": "proprietary free", "why": "Proprietary free license, no API." },
        { "name": "Adobe Stock free collection", "url": "https://stock.adobe.com/free", "categories": ["mogrt", "video"], "license": "Adobe Stock Free", "why": "Adobe account plus per-asset license grant." },
        { "name": "AEJuice free packs", "url": "https://aejuice.com/free-plugins/", "categories": ["transition", "overlay", "sfx"], "license": "AEJuice Free", "why": "Installer-delivered. Note: an AEJuice folder already exists locally - scan it instead of downloading." }
      ]
    }
  ]
}
