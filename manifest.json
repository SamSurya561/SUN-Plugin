{
  "manifestVersion": 5,
  "id": "com.sunplugin.premiere",
  "name": "Sun Plugin",
  "version": "0.1.0",
  "main": "src/ui/index.html",

  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0",
      "data": {
        "apiVersion": 2
      }
    }
  ],

  "requiredPermissions": {
    "$comment": "localFileSystem is 'request', not 'fullAccess': the user picks the library folder once through a picker and we hold a persistent token. Least privilege, and it avoids the consent friction of fullAccess. See docs/DEVELOPMENT-ASSET-SOURCES.md section 7.2.",
    "localFileSystem": "request",
    "launchProcess": {
      "schemes": ["https"],
      "extensions": []
    },
    "network": {
      "$comment": "DEVELOPMENT ONLY. Every domain here exists solely for the removable development ingestor, and each must match an enabled source in config/development-sources.json (verified by tools/check-boundaries.js). The production build ships this array EMPTY - see manifest.production.json - because nothing in src/core performs network I/O.",
      "domains": [
        "https://api.openverse.org",
        "https://archive.org",
        "https://commons.wikimedia.org",
        "https://upload.wikimedia.org",
        "https://api.github.com",
        "https://raw.githubusercontent.com",
        "https://codeload.github.com"
      ]
    },
    "clipboard": "readAndWrite",
    "allowCodeGenerationFromStrings": false,
    "ipc": {
      "enablePluginCommunication": false
    }
  },

  "entrypoints": [
    {
      "type": "panel",
      "id": "sun.library",
      "label": {
        "default": "Sun Library"
      },
      "minimumSize": { "width": 320, "height": 400 },
      "preferredDockedSize": { "width": 420, "height": 700 },
      "preferredFloatingSize": { "width": 900, "height": 640 },
      "icons": [
        { "width": 23, "height": 23, "path": "assets/branding/icons/icon-23.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light"] },
        { "width": 46, "height": 46, "path": "assets/branding/icons/icon-46.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light"] }
      ]
    }
  ],

  "icons": [
    { "width": 48, "height": 48, "path": "assets/branding/icons/icon-48.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light"], "species": ["pluginList"] },
    { "width": 96, "height": 96, "path": "assets/branding/icons/icon-96.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light"], "species": ["pluginList"] }
  ],

  "featureFlags": {
    "enableSWCSupport": true
  }
}
